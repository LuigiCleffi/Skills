{
  "name": "skills-code-kit",
  "version": "1.5.0",
  "description": "Installs agent instructions, a stage-gated harness, safety guards, and QA workflows into your project, for Claude Code, Codex, OpenCode, and any MCP client.",
  "scripts": {
    "build": "tsc",
    "skills-code-kit": "./dist/cli.js",
    "prepublishOnly": "npm run build",
    "release": "bash scripts/publish.sh",
    "check:frontmatter": "node scripts/check-frontmatter.mjs",
    "test": "npm run build && node --test 'tests/*.test.mjs'",
    "eval:routing": "node scripts/routing-eval.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuigiCleffi/Skills.git"
  },
  "files": [
    "dist/",
    "templates/",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "agents",
    "AGENTS.md",
    "ai-coding",
    "mcp",
    "skills",
    "harness",
    "code-review",
    "tdd",
    "bdd"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/LuigiCleffi/Skills/issues"
  },
  "homepage": "https://github.com/LuigiCleffi/Skills#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "bin": {
    "skills-code-kit": "dist/cli.js"
  }
}
